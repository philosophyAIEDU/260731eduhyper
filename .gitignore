# 작업하면서 생기는 것들 — 저장소에는 올리지 않습니다
node_modules/
.hyperframes/

# 렌더 결과물
*.mp4
*.webm
out.mp4
snapshots/

# 각자의 영상 자료 (사람마다 다름)
source/
assets/narration.mp3
assets/narration.wav
transcript.json
transcript.txt

# videos/<이름>/ 프로젝트 (원본 소스 오디오·화면 캡처·QA 스냅샷 — 저장소에는 코드/설정만)
videos/*/public/narration.*
videos/*/public/input-video.*
videos/*/qa_check/
videos/*/source-frames/

# Microsoft 시스템 폰트(맑은 고딕)는 재배포 라이선스가 없어 공개 저장소에 올리지 않습니다.
# 렌더에는 로컬 C:\Windows\Fonts 에서 복사해 로컬에서만 사용하세요.
videos/*/public/fonts/malgun*.ttf

*.log

# 시스템
.DS_Store
Thumbs.db
desktop.ini

# 렌더 작업 폴더
videos/*/renders/
