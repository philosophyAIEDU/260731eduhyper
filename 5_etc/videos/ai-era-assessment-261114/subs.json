[{"start": 0.0, "end": 3.88, "text": "AI 시대에 기존의 평가 방식 자체에 금이 가고 있습니다"}, {"start": 3.88, "end": 5.13, "text": "곧 수능인데요"}, {"start": 5.13, "end": 6.01, "text": "수능을 앞두고"}, {"start": 6.01, "end": 8.82, "text": "AI 안경이 굉장히 큰 논란입니다"}, {"start": 8.82, "end": 9.69, "text": "이 안경을 쓰면"}, {"start": 9.69, "end": 10.87, "text": "문제를 모르는 사람도"}, {"start": 10.87, "end": 12.25, "text": "쉽게 답을 선택할 수 있는"}, {"start": 12.25, "end": 13.58, "text": "그런 상황이 생깁니다"}, {"start": 13.58, "end": 16.73, "text": "그렇기 때문에 형평성에 문제가 분명히 있습니다"}, {"start": 16.73, "end": 18.71, "text": "그런데 지금 수능뿐만 아니라"}, {"start": 18.71, "end": 22.02, "text": "여러 전문직 시험에도 AI를 쓴 게 아니냐는"}, {"start": 22.02, "end": 23.61, "text": "의혹들이 일어나고 있습니다"}, {"start": 23.61, "end": 26.62, "text": "그러니까 예전에는 우리가 머릿속에 지식을 넣고"}, {"start": 26.62, "end": 27.53, "text": "한 군데 모여서"}, {"start": 27.53, "end": 29.0, "text": "오프라인에서 시험을 봤었습니다"}, {"start": 29.0, "end": 30.57, "text": "그래서 열심히 공부한 사람이"}, {"start": 30.57, "end": 31.98, "text": "당연히 좋은 점수를 받을 수 있는"}, {"start": 31.98, "end": 33.46, "text": "그러한 방식으로"}, {"start": 33.46, "end": 35.83, "text": "사람들의 능력을 평가하고 테스트했었는데요"}, {"start": 35.83, "end": 36.82, "text": "지금 AI 시대에는"}, {"start": 36.82, "end": 38.05, "text": "그러한 평가 방식에"}, {"start": 38.05, "end": 39.8, "text": "조금씩 금이 가고 있는 상황입니다"}, {"start": 39.8, "end": 42.62, "text": "물론 AI 안경 같은 게 없었으면 좋겠습니다, 저도"}, {"start": 42.62, "end": 45.47, "text": "하지만 AI 기술을 우리가 완벽하게 막을 수 있을까요?"}, {"start": 45.47, "end": 49.68, "text": "만약 AI 안경보다 더 작은 AI 도구가 나온다면"}, {"start": 49.68, "end": 50.69, "text": "그걸 막을 수 있을까요?"}, {"start": 50.69, "end": 53.81, "text": "이제는 AI를 배제하는 방법을 고민할 것이 아니라"}, {"start": 53.81, "end": 57.75, "text": "AI를 가지고 활용하는 사람들의 능력을 어떻게 평가할지를"}, {"start": 57.75, "end": 59.24, "text": "고민해 봐야 된다고 생각합니다"}, {"start": 59.24, "end": 60.82, "text": "AI의 발전이 너무 빠릅니다"}, {"start": 60.82, "end": 62.83, "text": "진짜 영화를 보고 있는 것 같고"}, {"start": 62.83, "end": 65.47, "text": "SF 소설책을 읽고 있는 것 같다는 생각이 듭니다"}, {"start": 65.47, "end": 67.93, "text": "그만큼 AI 발전이 너무 빠르고"}, {"start": 67.93, "end": 70.31, "text": "이미 AI가 AI를 개발하고 있습니다"}, {"start": 70.31, "end": 73.87, "text": "그렇기 때문에 인간의 속도를 이미 아득히 넘어섰습니다"}, {"start": 73.87, "end": 76.96000000000001, "text": "그래서 정말 새로운 AI 모델들이 빠르게 빠르게 나오고 있는데요"}, {"start": 76.96000000000001, "end": 79.49, "text": "지금 여러 AI 업체들도 경쟁하듯이"}, {"start": 79.49, "end": 81.14, "text": "새로운 모델을 내놓고 있습니다"}, {"start": 81.14, "end": 82.45, "text": "이러한 상황에서"}, {"start": 82.45, "end": 83.28, "text": "인간의 제도"}, {"start": 83.28, "end": 84.15, "text": "인간의 사회"}, {"start": 84.15, "end": 86.66, "text": "이러한 인간이 만들어낸 것들이"}, {"start": 86.66, "end": 88.39, "text": "AI 기술을 쫓아가지 못합니다"}, {"start": 88.39, "end": 91.08, "text": "그렇기 때문에 AI를 배제하는 방법만 찾다가는"}, {"start": 91.08, "end": 93.00999999999999, "text": "이미 AI는 더 멀리 가서"}, {"start": 93.00999999999999, "end": 96.66, "text": "우리에게 점점 난감한 상황을 만들어 줄 가능성이 높습니다"}, {"start": 96.66, "end": 101.02000000000001, "text": "그러니까 \"AI 쓰지 말라, AI 쓰면 부정행위다\"라고 규정하고"}, {"start": 101.02000000000001, "end": 103.28, "text": "AI를 안 쓰게끔만 하려다 보면"}, {"start": 103.28, "end": 106.39, "text": "오히려 교묘하게 AI를 써서 들키지 않는 사례들이"}, {"start": 106.39, "end": 107.42, "text": "더 늘어날 수 있는 거죠"}, {"start": 107.42, "end": 110.22999999999999, "text": "그래서 AI를 가지고 있는 사람의 능력을"}, {"start": 110.22999999999999, "end": 111.81, "text": "어떻게 평가할지를 고민해야"}, {"start": 111.81, "end": 112.91, "text": "이것만 인정하면"}, {"start": 112.91, "end": 115.78999999999999, "text": "훨씬 논의할 것들이 줄어들 거라고 생각합니다"}, {"start": 115.78999999999999, "end": 118.67, "text": "물론 AI를 쓰는 것 자체를 인정하기가 쉽지는 않습니다"}, {"start": 118.67, "end": 123.25, "text": "하지만 이것이 단순히 AI를 배제하는 것을 논의하는 것보다는"}, {"start": 123.25, "end": 125.06, "text": "더 나을 거라는 생각이 듭니다"}, {"start": 125.06, "end": 125.51, "text": "예를 들어,"}, {"start": 125.51, "end": 127.81, "text": "예전에는 전문직 시험을 보러 가게 되면"}, {"start": 127.81, "end": 129.32, "text": "객관식 시험을 봤고"}, {"start": 129.32, "end": 130.53, "text": "그다음에 주관식 시험을"}, {"start": 130.53, "end": 132.05, "text": "필기 형태로 봤었습니다"}, {"start": 132.05, "end": 134.98, "text": "그런데 이제는 AI 안경을 쓰게 되니까"}, {"start": 134.98, "end": 136.82999999999998, "text": "그러한 시험의 기능이"}, {"start": 136.82999999999998, "end": 138.3, "text": "무용지물이 되어가는"}, {"start": 138.3, "end": 140.38, "text": "그러한 상황이 점점 발생하게 되는데요"}, {"start": 140.38, "end": 143.34, "text": "이미 누군가는 AI 안경을 써서 들키지 않고"}, {"start": 143.34, "end": 144.62, "text": "합격을 했을 수도 있습니다"}, {"start": 144.62, "end": 148.78, "text": "그렇기 때문에 이제 어떠한 자격증 시험을 보게 되면"}, {"start": 148.78, "end": 151.11, "text": "AI를 무조건 못 쓰게 하는 것보다는"}, {"start": 151.11, "end": 152.68, "text": "AI를 활용해서라도"}, {"start": 152.68, "end": 155.14, "text": "이 사람이 이 자격증 관련된 일을"}, {"start": 155.14, "end": 157.93, "text": "얼마큼 잘 해내는지를 평가할 수 있어야 되는"}, {"start": 157.93, "end": 158.93, "text": "그러한 시기가 되었습니다"}, {"start": 158.93, "end": 160.34, "text": "저도 사람들이 AI 안 쓰면서"}, {"start": 160.34, "end": 161.3, "text": "시험을 봤으면 좋겠습니다"}, {"start": 161.3, "end": 162.57999999999998, "text": "근데 그걸 막기 어렵다면"}, {"start": 162.57999999999998, "end": 163.82999999999998, "text": "AI를 쓰게 하고"}, {"start": 163.82999999999998, "end": 165.46, "text": "이 사람이 AI를 쓰면서"}, {"start": 165.46, "end": 167.74, "text": "얼마만큼 자기의 능력을 발휘할 수 있는지를"}, {"start": 167.74, "end": 169.07999999999998, "text": "평가해야 된다는 겁니다"}, {"start": 169.07999999999998, "end": 173.04, "text": "단순히 예전처럼 단답식, 오지선다형으로 답을 찍고"}, {"start": 173.04, "end": 174.94, "text": "이 사람의 능력을 평가하는 것이 아니라"}, {"start": 174.94, "end": 176.22, "text": "AI를 활용해서"}, {"start": 176.22, "end": 177.76, "text": "이 사람이 이 분야에서"}, {"start": 177.76, "end": 181.47, "text": "얼마만큼 자신의 능력을 보일 수 있는지를"}, {"start": 181.47, "end": 182.48, "text": "평가해야 된다는 거죠"}, {"start": 182.48, "end": 183.38, "text": "쉽진 않지만"}, {"start": 183.38, "end": 186.59, "text": "AI를 가지고 시험을 본다는 것을 인정해야 된다"}, {"start": 186.59, "end": 189.0, "text": "그리고 AI를 활용한 이 사람의 능력을"}, {"start": 189.0, "end": 191.69, "text": "어떻게 평가할지를 고민해 봐야 된다는 겁니다"}, {"start": 191.69, "end": 194.95, "text": "여기까지만 결론이 나도 큰 진척이라고 생각합니다"}, {"start": 194.95, "end": 196.09, "text": "물론 쉽진 않겠죠"}, {"start": 196.09, "end": 199.68, "text": "사회적으로 이 사실을 받아들인다는 건 쉽지 않을 겁니다"}, {"start": 199.68, "end": 202.22, "text": "하지만 지금 상황을 보시면"}, {"start": 202.22, "end": 204.13, "text": "수능, 전문직 시험에"}, {"start": 204.13, "end": 205.76, "text": "AI 안경을 쓰는 경우가"}, {"start": 205.76, "end": 206.91, "text": "계속 등장하고 있고,"}, {"start": 206.91, "end": 209.15, "text": "AI 도구는 점점 작아질 겁니다"}, {"start": 209.15, "end": 210.43, "text": "작아지게 되면"}, {"start": 210.43, "end": 213.55, "text": "AI 안경처럼 딱 눈에 띄는 도구가 아닐 수도 있습니다"}, {"start": 213.55, "end": 217.84, "text": "그렇기 때문에 한시라도 새로운 평가 기준을 마련해야 된다고 생각합니다"}, {"start": 217.84, "end": 220.88, "text": "이 평가 기준을 마련할 때의 출발점은"}, {"start": 220.88, "end": 223.35, "text": "AI를 활용하도록 인정하는 겁니다"}, {"start": 223.35, "end": 224.79, "text": "물론 쉽진 않습니다"}, {"start": 224.79, "end": 227.82999999999998, "text": "하지만 고민을 해봐야 될 부분입니다"}, {"start": 227.82999999999998, "end": 230.46, "text": "이미 기존의 평가 방식에 금이 가고 있습니다"}, {"start": 230.46, "end": 232.43, "text": "한 번 금이 가기 시작하면"}, {"start": 232.43, "end": 233.47, "text": "그것은 메꾸기 어렵죠"}, {"start": 233.47, "end": 235.23, "text": "그것은 물리 법칙에 가깝습니다"}, {"start": 235.23, "end": 237.27, "text": "그렇기 때문에 AI가 가지고 온"}, {"start": 237.27, "end": 238.24, "text": "이 파장"}, {"start": 238.24, "end": 239.3, "text": "이 영향을"}, {"start": 239.3, "end": 241.03, "text": "우리가 어떻게 받아들이고"}, {"start": 241.03, "end": 243.47, "text": "결국엔 우리에게 도움이 되게끔 활용하려면"}, {"start": 243.47, "end": 244.6, "text": "빠르게 변화해야 되고"}, {"start": 244.6, "end": 246.9, "text": "빠르게 우리가 공부해 나가야 됩니다"}, {"start": 246.9, "end": 248.79, "text": "제가 말씀드린 것은 정답은 아닙니다"}, {"start": 248.79, "end": 250.98, "text": "저의 그냥 개인적인 생각일 뿐입니다"}, {"start": 250.98, "end": 253.83, "text": "그래도 우리가 이러한 사회 현상 속에서"}, {"start": 253.83, "end": 255.45, "text": "고민은 늘 해봐야 된다고 생각합니다"}, {"start": 255.45, "end": 257.93, "text": "선생님들도 이 이슈에 대해 어떻게 생각하시는지에 대해서"}, {"start": 257.93, "end": 259.93, "text": "댓글에 남겨주시면 감사하겠습니다"}, {"start": 259.93, "end": 261.13, "text": "오늘 영상은 여기까지입니다"}, {"start": 261.13, "end": 261.56, "text": "감사합니다"}]